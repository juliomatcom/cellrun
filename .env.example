# Copy to .env (git-ignored). Read by compose.yaml.

# Group id owning the Docker socket as seen from containers. Differs per host:
# - Linux: the host's `docker` group, usually 999 but not guaranteed.
#   Check: `stat -c %g /var/run/docker.sock`
# - Docker Desktop (macOS/Windows, local dev): 0 (socket is root:root in the VM)
# Wrong value -> orchestrator fails with "docker unreachable".
DOCKER_GID=999

# Provider key forwarded to task containers (see env_passthrough in job files).
OPENAI_API_KEY=

# Task containers the orchestrator runs at once (default 2). Size it to the
# host: each Goose task needs ~256 MiB RAM (+ up to 1 GiB swap).
MAX_PARALLEL=2

# Optional OCI runtime for task containers. `runsc` (gVisor) gives each task
# its own user-space kernel; install it on the host first (see README).
TASK_RUNTIME=

# Public DNS servers for task containers (private ranges are firewalled).
TASK_DNS=1.1.1.1,8.8.8.8

# Naming. Defaults below; embedders override them (see README, "Embedding").
# Image namespace: <ns>/orchestrator, <ns>/sandbox-guard, <ns>/goose-runner.
IMAGE_NAMESPACE=swarm
# Docker network shared with other services (event bus, database, ...).
BACKEND_NETWORK=swarm-backend
# Label prefix on task containers/networks.
LABEL_PREFIX=swarm
# Task bridge interface prefix (1-2 chars [a-z0-9]); also the firewall match.
BRIDGE_PREFIX=sw
